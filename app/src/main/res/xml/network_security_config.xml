<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local development servers - allow HTTP for testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Allow broader range of local IP addresses -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.2.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    
    <!-- Production API domain (api.pasabayan.com) - HTTPS with enhanced compatibility -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.pasabayan.com</domain>
        <domain includeSubdomains="true">pasabayan.com</domain>
        <trust-anchors>
            <!-- Include system certificates for better device compatibility -->
            <certificates src="system"/>
            <!-- Allow user-added certificates for corporate/testing scenarios -->
            <certificates src="user"/>
        </trust-anchors>
        <!-- Certificate pinning can be added here if needed for enhanced security -->
    </domain-config>
    
    <!-- Staging/Development API domains with enhanced compatibility -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">staging.pasabayan.com</domain>
        <domain includeSubdomains="true">dev.pasabayan.com</domain>
        <domain includeSubdomains="true">test.pasabayan.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    
    <!-- Enhanced default configuration for better device compatibility -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Include both system and user certificates by default -->
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    
    <!-- Enhanced debug overrides for development builds -->
    <debug-overrides>
        <!-- Allow cleartext traffic in debug builds for easier testing -->
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config> 